diff --git a/lib/VM/Profiler/SamplingProfilerPosix.cpp b/lib/VM/Profiler/SamplingProfilerPosix.cpp
index b6ad40e..ce27e80 100644
--- a/lib/VM/Profiler/SamplingProfilerPosix.cpp
+++ b/lib/VM/Profiler/SamplingProfilerPosix.cpp
@@ -183,7 +183,9 @@ static int invokeSignalAction(void (*handler)(int)) {
   memset(&actions, 0, sizeof(actions));
   sigemptyset(&actions.sa_mask);
   // Allows interrupted IO primitives to restart.
+#ifdef SA_RESTART
   actions.sa_flags = SA_RESTART;
+#endif
   actions.sa_handler = handler;
   return sigaction(SIGPROF, &actions, nullptr);
 }
