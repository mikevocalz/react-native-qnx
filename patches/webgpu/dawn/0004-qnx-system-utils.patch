+// react-native-qnx: QNX Neutrino exposes the running executable as /proc/self/exefile.
+std::optional<std::string> GetExecutablePath() {
+    std::array<char, PATH_MAX> path = {};
+    ssize_t result = readlink("/proc/self/exefile", path.data(), PATH_MAX - 1);
+    if (result < 0 || static_cast<size_t>(result) >= PATH_MAX - 1) {
+        return {};
+    }
+
+    path[sign_cast(result)] = '\0';
+    return path.data();
+}
