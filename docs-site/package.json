{
  "name": "react-native-qnx-docs",
  "version": "0.0.66",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out",
    "data": "node scripts/generate-data.mjs && node scripts/generate-api.mjs",
    "data:check": "node scripts/generate-data.mjs --check && node scripts/generate-api.mjs --check",
    "check:content": "node scripts/check-content.mjs",
    "check:search": "node scripts/check-search.mjs",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "api": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check"
  },
  "dependencies": {
    "cn": "^0.5.2",
    "fumadocs-core": "16.19.4",
    "fumadocs-mdx": "15.6.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.4",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "serve": "^14.2.7",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.6"
  }
}
