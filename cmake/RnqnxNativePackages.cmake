include_guard(GLOBAL)

# Link only native packages discovered from the selected app's installed
# production dependency graph. No product package is part of the RN platform.
function(rnqnx_link_native_packages consumer configuration)
  string(JSON package_type ERROR_VARIABLE absent TYPE "${configuration}" nativePackages)
  if(NOT absent STREQUAL "NOTFOUND")
    return()
  endif()
  if(NOT package_type STREQUAL "ARRAY")
    message(FATAL_ERROR "nativePackages must be a prepared array")
  endif()
  string(JSON count LENGTH "${configuration}" nativePackages)
  if(count EQUAL 0)
    return()
  endif()
  if(count GREATER 64 OR NOT TARGET rnqnx_nitro_core)
    message(FATAL_ERROR "Native packages require the host's single Nitro core and at most 64 registrations")
  endif()
  get_target_property(core_version rnqnx_nitro_core NITRO_CORE_VERSION)
  set(includes "#pragma once\n")
  set(registrations "namespace rnqnx::nativepackages {\ninline void registerPackages() {\n")
  set(seen_targets "")
  set(seen_registrations "")
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    foreach(key packageName version packageRoot manifestSha256 cmakeListsPath target registrationHeader registrationFunction)
      string(JSON kind ERROR_VARIABLE error TYPE "${configuration}" nativePackages ${index} ${key})
      if(NOT error STREQUAL "NOTFOUND" OR NOT kind STREQUAL "STRING")
        message(FATAL_ERROR "Invalid native package field ${key}")
      endif()
      string(JSON "${key}" GET "${configuration}" nativePackages ${index} ${key})
      if("${${key}}" MATCHES "[;\"$\\\n\r\t]")
        message(FATAL_ERROR "Unsupported metacharacters in native package ${key}")
      endif()
    endforeach()
    if(NOT target MATCHES "^[A-Za-z_][A-Za-z0-9_.+-]*$" OR
       NOT registrationFunction MATCHES "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$" OR
       registrationHeader MATCHES "[<>]" OR IS_ABSOLUTE "${registrationHeader}" OR
       registrationHeader MATCHES "(^|/)\\.\\.?(/|$)" OR
       NOT IS_ABSOLUTE "${packageRoot}" OR IS_ABSOLUTE "${cmakeListsPath}" OR
       cmakeListsPath MATCHES "(^|/)\\.\\.?(/|$)" OR
       NOT cmakeListsPath MATCHES "(^|/)CMakeLists\\.txt$")
      message(FATAL_ERROR "Invalid prepared native package identity/path")
    endif()
    if(target IN_LIST seen_targets OR registrationFunction IN_LIST seen_registrations)
      message(FATAL_ERROR "Duplicate native package target or registration")
    endif()
    list(APPEND seen_targets "${target}")
    list(APPEND seen_registrations "${registrationFunction}")
    if(NOT EXISTS "${packageRoot}/package.json" OR NOT EXISTS "${packageRoot}/${cmakeListsPath}")
      message(FATAL_ERROR "Installed native package ${packageName} is missing; prepare it again")
    endif()
    file(SHA256 "${packageRoot}/package.json" actual_hash)
    if(NOT actual_hash STREQUAL manifestSha256)
      message(FATAL_ERROR "Native package ${packageName} changed; prepare its configuration again")
    endif()
    file(REAL_PATH "${packageRoot}" real_root)
    file(REAL_PATH "${packageRoot}/${cmakeListsPath}" real_cmake)
    string(FIND "${real_cmake}" "${real_root}/" inside)
    if(NOT inside EQUAL 0)
      message(FATAL_ERROR "Native CMake path escaped its installed package")
    endif()
    string(JSON versions_type TYPE "${configuration}" nativePackages ${index} nitroCoreVersions)
    if(NOT versions_type STREQUAL "ARRAY")
      message(FATAL_ERROR "Native package needs exact nitroCoreVersions")
    endif()
    string(JSON versions_count LENGTH "${configuration}" nativePackages ${index} nitroCoreVersions)
    if(versions_count LESS 1 OR versions_count GREATER 8)
      message(FATAL_ERROR "Native package version profile is invalid")
    endif()
    set(compatible FALSE)
    math(EXPR version_last "${versions_count} - 1")
    foreach(version_index RANGE 0 ${version_last})
      string(JSON accepted GET "${configuration}" nativePackages ${index} nitroCoreVersions ${version_index})
      if(core_version STREQUAL accepted)
        set(compatible TRUE)
      endif()
    endforeach()
    if(NOT compatible)
      message(FATAL_ERROR "${packageName} does not support the host Nitro core '${core_version}'")
    endif()
    string(JSON dispatcher_type TYPE "${configuration}" nativePackages ${index} requiresDispatcher)
    string(JSON dispatcher GET "${configuration}" nativePackages ${index} requiresDispatcher)
    if(NOT dispatcher_type STREQUAL "BOOLEAN")
      message(FATAL_ERROR "Native packages must declare requiresDispatcher")
    endif()
    if(dispatcher AND NOT TARGET rnqnx_nitro_qt)
      message(FATAL_ERROR "${packageName} requires the real Qt/JavaScript Nitro dispatcher")
    endif()
    get_filename_component(source "${real_cmake}" DIRECTORY)
    add_subdirectory("${source}" "${CMAKE_CURRENT_BINARY_DIR}/native-packages/${index}")
    if(NOT TARGET "${target}")
      message(FATAL_ERROR "Native package ${packageName} did not provide ${target}")
    endif()
    target_link_libraries(${consumer} PRIVATE "${target}")
    string(APPEND includes "#include <${registrationHeader}>\n")
    string(APPEND registrations "  ::${registrationFunction}();\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
      "${packageRoot}/package.json" "${real_cmake}")
  endforeach()
  string(APPEND registrations "}\n} // namespace rnqnx::nativepackages\n")
  set(header "${CMAKE_CURRENT_BINARY_DIR}/${consumer}-NativePackages.generated.h")
  file(WRITE "${header}" "${includes}\n${registrations}")
  target_compile_definitions(${consumer} PRIVATE RNQNX_NATIVE_PACKAGES_HEADER="${header}")
endfunction()
