include_guard(GLOBAL)
option(RNQNX_ENABLE_WINDOW_API "Enable experimental Nitro v1 single-window handles" OFF)
if(RNQNX_ENABLE_WINDOW_API)
  if(NOT RNQNX_ENABLE_WINDOW_CHROME OR NOT RNQNX_ENABLE_NITRO_QT_DISPATCHER)
    message(FATAL_ERROR "RNQNX_ENABLE_WINDOW_API requires window chrome and the owned Nitro Qt dispatcher")
  endif()
  if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Linux|Darwin|QNX)$" OR RNQNX_BUILD_MARATHON_HOST)
    message(FATAL_ERROR "Window API is available only for QNX and its Linux/macOS host fixtures")
  endif()
endif()
function(rnqnx_add_window_api)
  if(NOT RNQNX_ENABLE_WINDOW_API OR TARGET rnqnx_window_api)
    return()
  endif()
  set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
  add_library(rnqnx_window_api STATIC
    "${root}/native/window-chrome/WindowSession.cpp"
    "${root}/packages/qnx-nitro-runtime/cpp/QnxWindow.cpp"
    "${root}/packages/qnx-nitro-runtime/cpp/QnxWindowHostInstall.cpp"
    "${root}/packages/qnx-nitro-runtime/cpp/WindowObserver.cpp")
  target_include_directories(rnqnx_window_api PUBLIC "${root}/packages/qnx-nitro-runtime/cpp")
  target_link_libraries(rnqnx_window_api PUBLIC rnqnx_react_host rnqnx_nitro_qt)
  target_compile_features(rnqnx_window_api PUBLIC cxx_std_20)
  target_compile_definitions(rnqnx_window_api PUBLIC RNQNX_ENABLE_WINDOW_API=1)
  target_compile_options(rnqnx_window_api PRIVATE "-include" "${RNQNX_NITRO_V1_COMPAT}")
  rnqnx_enable_strict_warnings(rnqnx_window_api)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "QNX" AND RNQNX_ENABLE_HOST_SANITIZERS)
    target_compile_options(rnqnx_window_api PRIVATE
      -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer)
    target_link_options(rnqnx_window_api PUBLIC -fsanitize=address,undefined)
  endif()
  if(BUILD_TESTING AND NOT CMAKE_SYSTEM_NAME STREQUAL "QNX")
    add_executable(rnqnx_window_api_test "${root}/tests/cpp/WindowApiHermesTest.cpp")
    target_link_libraries(rnqnx_window_api_test PRIVATE rnqnx_window_api rnqnx_nitro_qnx)
    target_compile_options(rnqnx_window_api_test PRIVATE "-include" "${RNQNX_NITRO_V1_COMPAT}")
    rnqnx_enable_strict_warnings(rnqnx_window_api_test)
    add_test(NAME rnqnx_window_api COMMAND rnqnx_window_api_test)
    set_tests_properties(rnqnx_window_api PROPERTIES TIMEOUT 60 ENVIRONMENT
      "QT_QPA_PLATFORM=offscreen;QT_QUICK_BACKEND=software;ASAN_OPTIONS=detect_leaks=0:halt_on_error=1")
  endif()
endfunction()
