# Verifies a react-native-qnx/metro-assets-v1 inventory and, when DESTINATION
# is set, copies each listed file to DESTINATION/<path>. Used by configure
# (include) and by the POST_BUILD step (cmake -P). Inputs: INVENTORY,
# EXPECTED_SHA256, BUNDLE_SHA256, PLATFORM, BINDING, optional DESTINATION.
foreach(required INVENTORY EXPECTED_SHA256 BUNDLE_SHA256 PLATFORM BINDING)
  if("${${required}}" STREQUAL "")
    message(FATAL_ERROR "Consumer asset staging requires ${required}")
  endif()
endforeach()
if(NOT IS_ABSOLUTE "${INVENTORY}" OR NOT EXISTS "${INVENTORY}" OR IS_DIRECTORY "${INVENTORY}" OR
    IS_SYMLINK "${INVENTORY}" OR INVENTORY MATCHES "[;\"$\n\r]")
  message(FATAL_ERROR "Consumer asset inventory must be an absolute regular file")
endif()
file(SIZE "${INVENTORY}" _rnqnx_inventory_size)
if(_rnqnx_inventory_size LESS 1 OR _rnqnx_inventory_size GREATER 4194304)
  message(FATAL_ERROR "Consumer asset inventory exceeds its size limit")
endif()
file(SHA256 "${INVENTORY}" _rnqnx_inventory_hash)
if(NOT _rnqnx_inventory_hash STREQUAL EXPECTED_SHA256)
  message(FATAL_ERROR "Consumer asset inventory changed; prepare its configuration again")
endif()
file(READ "${INVENTORY}" _rnqnx_inventory)
foreach(_rnqnx_key schemaVersion generatedBy platform bundleSha256)
  string(JSON "_rnqnx_${_rnqnx_key}" ERROR_VARIABLE _rnqnx_error GET "${_rnqnx_inventory}" "${_rnqnx_key}")
  if(NOT _rnqnx_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "Consumer asset inventory is missing ${_rnqnx_key}")
  endif()
endforeach()
if(NOT _rnqnx_schemaVersion STREQUAL "1" OR
    NOT _rnqnx_generatedBy STREQUAL "react-native-qnx/metro-assets-v1" OR
    NOT _rnqnx_platform STREQUAL PLATFORM)
  message(FATAL_ERROR "Unsupported consumer asset inventory")
endif()
if(BINDING STREQUAL "bundle-sha256")
  if(NOT _rnqnx_bundleSha256 STREQUAL BUNDLE_SHA256)
    message(FATAL_ERROR "Consumer asset inventory belongs to a different bundle")
  endif()
elseif(NOT BINDING STREQUAL "source-js-unverified-hbc")
  message(FATAL_ERROR "Unsupported consumer asset bundle binding")
endif()
string(JSON _rnqnx_count ERROR_VARIABLE _rnqnx_error LENGTH "${_rnqnx_inventory}" assets)
if(NOT _rnqnx_error STREQUAL "NOTFOUND" OR _rnqnx_count GREATER 4096)
  message(FATAL_ERROR "Consumer asset inventory has an invalid asset list")
endif()
get_filename_component(_rnqnx_base "${INVENTORY}" DIRECTORY)
if(DEFINED DESTINATION AND NOT DESTINATION STREQUAL "")
  if(IS_SYMLINK "${DESTINATION}/assets" OR (EXISTS "${DESTINATION}/assets" AND NOT IS_DIRECTORY "${DESTINATION}/assets"))
    message(FATAL_ERROR "Consumer asset destination is unsafe")
  endif()
endif()
set(_rnqnx_seen "")
if(_rnqnx_count GREATER 0)
  math(EXPR _rnqnx_last "${_rnqnx_count} - 1")
  foreach(_rnqnx_index RANGE ${_rnqnx_last})
    string(JSON _rnqnx_path GET "${_rnqnx_inventory}" assets ${_rnqnx_index} path)
    string(JSON _rnqnx_sha GET "${_rnqnx_inventory}" assets ${_rnqnx_index} sha256)
    if(NOT _rnqnx_path MATCHES "^assets(/[A-Za-z0-9_][A-Za-z0-9_.+@-]*)+$" OR
        _rnqnx_path MATCHES "/\\.\\.?(/|$)" OR NOT _rnqnx_sha MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "Consumer asset inventory has an unsafe entry")
    endif()
    string(TOLOWER "${_rnqnx_path}" _rnqnx_folded)
    list(FIND _rnqnx_seen "${_rnqnx_folded}" _rnqnx_found)
    if(NOT _rnqnx_found EQUAL -1)
      message(FATAL_ERROR "Consumer asset inventory has colliding entries")
    endif()
    list(APPEND _rnqnx_seen "${_rnqnx_folded}")
    set(_rnqnx_source "${_rnqnx_base}/${_rnqnx_path}")
    if(NOT EXISTS "${_rnqnx_source}" OR IS_DIRECTORY "${_rnqnx_source}" OR IS_SYMLINK "${_rnqnx_source}")
      message(FATAL_ERROR "Consumer asset ${_rnqnx_path} is missing or unsafe")
    endif()
    file(SHA256 "${_rnqnx_source}" _rnqnx_actual)
    if(NOT _rnqnx_actual STREQUAL _rnqnx_sha)
      message(FATAL_ERROR "Consumer asset ${_rnqnx_path} changed after bundling")
    endif()
    if(DEFINED DESTINATION AND NOT DESTINATION STREQUAL "")
      set(_rnqnx_target "${DESTINATION}/${_rnqnx_path}")
      if(IS_SYMLINK "${_rnqnx_target}" OR IS_DIRECTORY "${_rnqnx_target}")
        message(FATAL_ERROR "Consumer asset destination ${_rnqnx_path} is unsafe")
      endif()
      get_filename_component(_rnqnx_parent "${_rnqnx_target}" DIRECTORY)
      file(MAKE_DIRECTORY "${_rnqnx_parent}")
      file(COPY_FILE "${_rnqnx_source}" "${_rnqnx_target}" ONLY_IF_DIFFERENT)
      file(SHA256 "${_rnqnx_target}" _rnqnx_staged)
      if(NOT _rnqnx_staged STREQUAL _rnqnx_sha)
        message(FATAL_ERROR "Staged consumer asset ${_rnqnx_path} hash mismatch")
      endif()
    endif()
  endforeach()
endif()
set(RNQNX_CONSUMER_ASSET_COUNT "${_rnqnx_count}")
