include_guard(GLOBAL)
option(RNQNX_ENABLE_FRAME_TRACE "Enable bounded native runtime diagnostic trace sessions" OFF)
if(RNQNX_ENABLE_FRAME_TRACE AND NOT CMAKE_SYSTEM_NAME MATCHES "^(Linux|Darwin|QNX)$")
  message(FATAL_ERROR "RNQNX_ENABLE_FRAME_TRACE requires Linux, Darwin or QNX")
endif()

function(rnqnx_add_runtime_trace)
  if(NOT RNQNX_ENABLE_FRAME_TRACE OR TARGET rnqnx_runtime_trace)
    return()
  endif()
  set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
  find_package(Threads REQUIRED)
  add_library(rnqnx_runtime_trace STATIC "${root}/vnext/src/runtime/RuntimeTrace.cpp")
  target_include_directories(rnqnx_runtime_trace PUBLIC "${root}/vnext/include")
  target_compile_features(rnqnx_runtime_trace PUBLIC cxx_std_20)
  target_compile_definitions(rnqnx_runtime_trace PUBLIC RNQNX_ENABLE_FRAME_TRACE=1)
  target_link_libraries(rnqnx_runtime_trace PUBLIC Threads::Threads)
  target_compile_options(rnqnx_runtime_trace PRIVATE -Wall -Wextra -Wpedantic -Werror)
  add_executable(rnqnx_runtime_trace_test "${root}/tests/native/runtime-trace/RuntimeTraceTest.cpp")
  target_link_libraries(rnqnx_runtime_trace_test PRIVATE rnqnx_runtime_trace)
  target_compile_options(rnqnx_runtime_trace_test PRIVATE -Wall -Wextra -Wpedantic -Werror)
  set_target_properties(rnqnx_runtime_trace_test PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "QNX" AND RNQNX_ENABLE_HOST_SANITIZERS AND
      CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
    foreach(target rnqnx_runtime_trace rnqnx_runtime_trace_test)
      target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer)
      target_link_options(${target} PUBLIC -fsanitize=address,undefined)
    endforeach()
  endif()
  if(BUILD_TESTING AND NOT CMAKE_CROSSCOMPILING)
    add_test(NAME rnqnx_runtime_trace_test COMMAND rnqnx_runtime_trace_test)
    set_tests_properties(rnqnx_runtime_trace_test PROPERTIES TIMEOUT 15)
    add_test(NAME rnqnx_runtime_trace_json COMMAND "${CMAKE_COMMAND}"
      "-DPROBE=$<TARGET_FILE:rnqnx_runtime_trace_test>"
      -P "${root}/tests/native/runtime-trace/TraceJson.cmake")
    set_tests_properties(rnqnx_runtime_trace_json PROPERTIES TIMEOUT 15)
  endif()
endfunction()
