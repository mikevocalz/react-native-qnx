include_guard(GLOBAL)
option(RNQNX_ENABLE_EXPO_CONSTANTS "Expose embedded public Expo config and real Qt session constants" OFF)
set(RNQNX_EXPO_PUBLIC_CONFIG "" CACHE FILEPATH "Reviewed public Expo config JSON, never private app config")
function(rnqnx_configure_expo_constants target)
  target_compile_definitions(${target} PUBLIC RNQNX_ENABLE_EXPO_CONSTANTS=$<BOOL:${RNQNX_ENABLE_EXPO_CONSTANTS}>)
  if(NOT RNQNX_ENABLE_EXPO_CONSTANTS)
    return()
  endif()
  if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Linux|QNX)$")
    message(FATAL_ERROR "Expo Constants supports QNX or Linux native hosts only")
  endif()
  set(RNQNX_EXPO_CONSTANTS_CONFIG_HEX "")
  if(RNQNX_EXPO_PUBLIC_CONFIG)
    if(NOT IS_ABSOLUTE "${RNQNX_EXPO_PUBLIC_CONFIG}" OR NOT EXISTS "${RNQNX_EXPO_PUBLIC_CONFIG}")
      message(FATAL_ERROR "Expo public config must be an existing absolute JSON path")
    endif()
    file(SIZE "${RNQNX_EXPO_PUBLIC_CONFIG}" config_size)
    if(config_size GREATER 1048576)
      message(FATAL_ERROR "Expo public config exceeds 1 MiB")
    endif()
    file(READ "${RNQNX_EXPO_PUBLIC_CONFIG}" config_json)
    string(JSON config_type ERROR_VARIABLE config_error TYPE "${config_json}")
    if(config_error OR NOT config_type STREQUAL "OBJECT")
      message(FATAL_ERROR "Expo public config must be a JSON object")
    endif()
    string(JSON wrapped_type ERROR_VARIABLE wrapped_error TYPE "${config_json}" expo)
    if(NOT wrapped_error)
      message(FATAL_ERROR "Use resolved public Expo config, not an app.json expo wrapper")
    endif()
    string(JSON scheme_type ERROR_VARIABLE scheme_error TYPE "${config_json}" scheme)
    if(NOT scheme_error)
      if(NOT scheme_type STREQUAL "STRING")
        message(FATAL_ERROR "This Expo Constants slice requires a single string scheme")
      endif()
      string(JSON scheme GET "${config_json}" scheme)
      if(NOT scheme MATCHES "^[a-zA-Z][a-zA-Z0-9+.-]*$")
        message(FATAL_ERROR "Expo scheme must be a valid URI scheme")
      endif()
    endif()
    file(READ "${RNQNX_EXPO_PUBLIC_CONFIG}" RNQNX_EXPO_CONSTANTS_CONFIG_HEX HEX)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${RNQNX_EXPO_PUBLIC_CONFIG}")
  endif()
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../packages/expo-modules-core-qnx/cpp/ExpoQnxConstantsConfig.hpp.in"
    "${CMAKE_CURRENT_BINARY_DIR}/expo-constants-generated/ExpoQnxConstantsConfig.hpp" @ONLY)
  target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/expo-constants-generated")
  target_sources(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../packages/expo-modules-core-qnx/cpp/ExpoQnxConstants.cpp")
  find_package(Qt6 6.11.1 REQUIRED COMPONENTS Core Gui)
  target_link_libraries(${target} PUBLIC Qt6::Core Qt6::Gui)
endfunction()
