if(NOT EXISTS "${SOURCE}" OR IS_DIRECTORY "${SOURCE}" OR IS_SYMLINK "${SOURCE}")
  message(FATAL_ERROR "Consumer bundle source is missing or unsafe")
endif()
file(SHA256 "${SOURCE}" before)
if(NOT before STREQUAL EXPECTED_SHA256)
  message(FATAL_ERROR "Consumer bundle changed after configuration")
endif()
if(IS_SYMLINK "${DESTINATION}" OR IS_DIRECTORY "${DESTINATION}")
  message(FATAL_ERROR "Consumer bundle destination is unsafe")
endif()
file(COPY_FILE "${SOURCE}" "${DESTINATION}" ONLY_IF_DIFFERENT)
file(SHA256 "${DESTINATION}" staged)
if(NOT staged STREQUAL EXPECTED_SHA256)
  message(FATAL_ERROR "Staged consumer bundle hash mismatch")
endif()
