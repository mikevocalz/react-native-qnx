include_guard(GLOBAL)

# Reads the optional `window` object that prepare-native writes (PR #122 shape:
# controls, titleBarStyle, initialSize) and generates a header for main.cpp.
# The same rules as resolveQnxWindow and rnqnx::window::parseWindowChromeConfig.
# A descriptor without `window` predates the field and keeps the chromeless
# window. See docs/adr/0016.
function(rnqnx_consumer_window_chrome config output_dir out_header)
  set(controls "macos")
  set(style "none")
  set(width 0)
  set(height 0)
  string(JSON window_type ERROR_VARIABLE json_error TYPE "${config}" window)
  if(json_error STREQUAL "NOTFOUND")
    if(NOT window_type STREQUAL "OBJECT")
      message(FATAL_ERROR "Consumer window must be an object")
    endif()
    set(style "default")
    string(JSON member_count LENGTH "${config}" window)
    if(member_count GREATER 0)
      math(EXPR last "${member_count} - 1")
      foreach(index RANGE ${last})
        string(JSON key MEMBER "${config}" window ${index})
        if(NOT key MATCHES "^(controls|titleBarStyle|initialSize)$")
          message(FATAL_ERROR "Consumer window.${key} is not a supported window option")
        endif()
      endforeach()
    endif()
    foreach(pair "controls;controls;^(macos|windows)$" "titleBarStyle;style;^(default|hidden|none)$")
      list(GET pair 0 key)
      list(GET pair 1 variable)
      list(GET pair 2 pattern)
      string(JSON kind ERROR_VARIABLE json_error TYPE "${config}" window ${key})
      if(json_error STREQUAL "NOTFOUND")
        string(JSON value GET "${config}" window ${key})
        if(NOT kind STREQUAL "STRING" OR NOT value MATCHES "${pattern}")
          message(FATAL_ERROR "Invalid consumer window.${key}")
        endif()
        set(${variable} "${value}")
      endif()
    endforeach()
    string(JSON kind ERROR_VARIABLE json_error TYPE "${config}" window initialSize)
    if(json_error STREQUAL "NOTFOUND")
      string(JSON size_members ERROR_VARIABLE size_error LENGTH "${config}" window initialSize)
      if(NOT kind STREQUAL "OBJECT" OR NOT size_members EQUAL 2)
        message(FATAL_ERROR "Consumer window.initialSize must be {width, height}")
      endif()
      foreach(edge width height)
        string(JSON edge_kind ERROR_VARIABLE edge_error TYPE "${config}" window initialSize ${edge})
        string(JSON value ERROR_VARIABLE value_error GET "${config}" window initialSize ${edge})
        if(NOT edge_error STREQUAL "NOTFOUND" OR NOT value_error STREQUAL "NOTFOUND" OR
            NOT edge_kind STREQUAL "NUMBER" OR NOT value MATCHES "^[1-9][0-9]*$" OR value GREATER 16384)
          message(FATAL_ERROR "Consumer window.initialSize.${edge} must be an integer from 1 to 16384")
        endif()
        set(${edge} "${value}")
      endforeach()
    endif()
  endif()
  set(RNQNX_WINDOW_CONTROLS "${controls}")
  set(RNQNX_WINDOW_STYLE "${style}")
  set(RNQNX_WINDOW_WIDTH "${width}")
  set(RNQNX_WINDOW_HEIGHT "${height}")
  set(header "${output_dir}/WindowChrome.generated.h")
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ConsumerWindowChrome.h.in" "${header}" @ONLY)
  set(${out_header} "${header}" PARENT_SCOPE)
endfunction()

# Reuse the existing renderer and native main. This is an opt-in source build,
# not an installer, SDK bundle or proof that target plugins are distributable.
function(rnqnx_add_consumer_app)
  if(NOT TARGET rnqnx_react_host)
    message(FATAL_ERROR "Consumer app requires the existing full Qt/Hermes/Fabric host")
  endif()
  if(NOT IS_ABSOLUTE "${RNQNX_CONSUMER_CONFIG}" OR
      NOT EXISTS "${RNQNX_CONSUMER_CONFIG}" OR
      IS_DIRECTORY "${RNQNX_CONSUMER_CONFIG}" OR IS_SYMLINK "${RNQNX_CONSUMER_CONFIG}")
    message(FATAL_ERROR "RNQNX_CONSUMER_CONFIG must be an absolute regular generated JSON file")
  endif()
  file(SIZE "${RNQNX_CONSUMER_CONFIG}" config_size)
  if(config_size GREATER 65536 OR config_size LESS 1)
    message(FATAL_ERROR "Consumer configuration exceeds its size limit")
  endif()
  file(READ "${RNQNX_CONSUMER_CONFIG}" config)
  string(JSON schema ERROR_VARIABLE json_error GET "${config}" schemaVersion)
  if(NOT json_error STREQUAL "NOTFOUND" OR NOT schema STREQUAL "1")
    message(FATAL_ERROR "Invalid consumer configuration schema")
  endif()
  foreach(key generatedBy appId displayName componentName platform bundle bundleSha256 shortName)
    string(JSON kind ERROR_VARIABLE json_error TYPE "${config}" "${key}")
    if(NOT json_error STREQUAL "NOTFOUND" OR NOT kind STREQUAL "STRING")
      message(FATAL_ERROR "Missing or invalid consumer field ${key}")
    endif()
    string(JSON "${key}" GET "${config}" "${key}")
  endforeach()
  if(NOT generatedBy STREQUAL "react-native-qnx/prepare-native-v1")
    message(FATAL_ERROR "Consumer configuration has an unsupported generator")
  endif()
  string(LENGTH "${appId}" id_size)
  string(LENGTH "${componentName}" component_size)
  if(id_size GREATER 255 OR appId MATCHES "[^A-Za-z0-9_.]" OR NOT appId MATCHES "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$" OR appId MATCHES "\\.desktop$")
    message(FATAL_ERROR "Invalid consumer application ID")
  endif()
  if(component_size GREATER 128 OR componentName MATCHES "[^A-Za-z0-9_]" OR NOT componentName MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
    message(FATAL_ERROR "Invalid consumer component name")
  endif()
  if(displayName STREQUAL "" OR displayName MATCHES "[\n\r\t]")
    message(FATAL_ERROR "Invalid consumer display name")
  endif()
  if(platform STREQUAL "qnx")
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "QNX")
      if(NOT RNQNX_CONSUMER_HOST_PREVIEW OR NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        message(FATAL_ERROR "QNX consumer needs a QNX toolchain; Linux preview must be explicitly enabled")
      endif()
      message(STATUS "Consumer evidence scope: Linux host preview, NOT QNX execution")
    endif()
  elseif(platform STREQUAL "marathon")
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
      message(FATAL_ERROR "Marathon consumer needs a Linux toolchain")
    endif()
  else()
    message(FATAL_ERROR "Consumer platform must be qnx or marathon")
  endif()
  if(NOT IS_ABSOLUTE "${bundle}" OR NOT EXISTS "${bundle}" OR IS_DIRECTORY "${bundle}" OR IS_SYMLINK "${bundle}" OR bundle MATCHES "[;\"$\n\r]")
    message(FATAL_ERROR "Consumer bundle must be an absolute regular file")
  endif()
  file(SIZE "${bundle}" bundle_size)
  if(bundle_size LESS 1 OR bundle_size GREATER 268435456)
    message(FATAL_ERROR "Consumer bundle exceeds its size limit")
  endif()
  if(CMAKE_SYSTEM_NAME STREQUAL "QNX" AND NOT bundle MATCHES "\\.hbc$")
    message(FATAL_ERROR "Lean QNX Hermes requires a precompiled .hbc bundle from the matched host compiler")
  endif()
  file(SHA256 "${bundle}" actual_hash)
  if(NOT actual_hash STREQUAL bundleSha256)
    message(FATAL_ERROR "Consumer bundle hash changed; prepare its configuration again")
  endif()
  # The generated icon set: square PNGs named icon-<size>.png, each pinned by
  # the hash prepare-native recorded. Staged next to the executable.
  string(JSON icon_sizes_count ERROR_VARIABLE json_error LENGTH "${config}" icon sizes)
  if(NOT json_error STREQUAL "NOTFOUND" OR icon_sizes_count GREATER 32)
    message(FATAL_ERROR "Consumer configuration has no icon entry; run project prepare-native")
  endif()
  set(icon_sizes "")
  set(icon_files "")
  set(icon_hashes "")
  if(icon_sizes_count EQUAL 0)
    # prepare-native --skip-identity-tool: build without an icon set.
    message(WARNING "Consumer icon set was not generated; the app will use the platform default icon")
    set(icon_indices "")
  else()
    math(EXPR icon_last "${icon_sizes_count} - 1")
    foreach(index RANGE ${icon_last})
      list(APPEND icon_indices "${index}")
    endforeach()
  endif()
  foreach(index IN LISTS icon_indices)
    string(JSON icon_size ERROR_VARIABLE json_error GET "${config}" icon sizes ${index} size)
    string(JSON icon_path ERROR_VARIABLE path_error GET "${config}" icon sizes ${index} path)
    string(JSON icon_hash ERROR_VARIABLE hash_error GET "${config}" icon sizes ${index} sha256)
    if(NOT json_error STREQUAL "NOTFOUND" OR NOT path_error STREQUAL "NOTFOUND" OR NOT hash_error STREQUAL "NOTFOUND" OR
        NOT icon_size MATCHES "^[1-9][0-9]*$" OR icon_size GREATER 1024 OR NOT icon_hash MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "Invalid consumer icon entry ${index}")
    endif()
    get_filename_component(icon_name "${icon_path}" NAME)
    if(NOT IS_ABSOLUTE "${icon_path}" OR NOT EXISTS "${icon_path}" OR IS_DIRECTORY "${icon_path}" OR IS_SYMLINK "${icon_path}" OR
        icon_path MATCHES "[;\"$\n\r]" OR NOT icon_name STREQUAL "icon-${icon_size}.png")
      message(FATAL_ERROR "Consumer icon ${icon_size} must be an absolute regular icon-${icon_size}.png file")
    endif()
    file(SHA256 "${icon_path}" actual_icon_hash)
    if(NOT actual_icon_hash STREQUAL icon_hash)
      message(FATAL_ERROR "Consumer icon ${icon_size} hash changed; prepare its configuration again")
    endif()
    list(APPEND icon_sizes "${icon_size}")
    list(APPEND icon_files "${icon_path}")
    list(APPEND icon_hashes "${icon_hash}")
  endforeach()
  list(JOIN icon_sizes ", " iconSizes_cpp)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${RNQNX_CONSUMER_CONFIG}" "${bundle}" ${icon_files})
  foreach(key appId displayName componentName)
    string(REPLACE "\\" "\\\\" "${key}_cpp" "${${key}}")
    string(REPLACE "\"" "\\\"" "${key}_cpp" "${${key}_cpp}")
  endforeach()
  set(output_dir "${CMAKE_BINARY_DIR}/consumer/${platform}/${appId}")
  file(MAKE_DIRECTORY "${output_dir}")
  set(header "${output_dir}/ApplicationIdentity.generated.h")
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ConsumerApplicationIdentity.h.in" "${header}" @ONLY)
  # With the chrome OFF the descriptor's window object is left alone, so the
  # configure and the executable are the same as before (docs/adr/0016).
  if(RNQNX_ENABLE_WINDOW_CHROME)
    rnqnx_consumer_window_chrome("${config}" "${output_dir}" window_header)
  else()
    string(JSON window_type ERROR_VARIABLE window_error TYPE "${config}" window)
    if(window_error STREQUAL "NOTFOUND")
      message(STATUS "Consumer window chrome is not drawn: RNQNX_ENABLE_WINDOW_CHROME=OFF")
    endif()
  endif()
  add_executable(rnqnx_consumer_app "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../vnext/probes/playground/main.cpp")
  target_link_libraries(rnqnx_consumer_app PRIVATE rnqnx_react_host)
  rnqnx_enable_strict_warnings(rnqnx_consumer_app)
  target_compile_definitions(rnqnx_consumer_app PRIVATE RNQNX_CONSUMER_APP_HEADER="${header}" RNQNX_PLAYGROUND_BUNDLE_PATH="")
  if(RNQNX_ENABLE_WINDOW_CHROME)
    target_compile_definitions(rnqnx_consumer_app PRIVATE RNQNX_CONSUMER_WINDOW_HEADER="${window_header}")
  endif()
  if(platform STREQUAL "marathon")
    target_compile_definitions(rnqnx_consumer_app PRIVATE RNQNX_MARATHON_HOST=1)
  endif()
  if(TARGET rnqnx_nitro_qnx)
    target_link_libraries(rnqnx_consumer_app PRIVATE rnqnx_nitro_qnx)
    target_compile_definitions(rnqnx_consumer_app PRIVATE RNQNX_PLAYGROUND_NITRO_QNX=1)
  endif()
  if(TARGET rnqnx_nitro_qt)
    if(NOT TARGET rnqnx_nitro_qnx)
      message(FATAL_ERROR "Consumer Nitro dispatcher requires its matched runtime adapter")
    endif()
    target_link_libraries(rnqnx_consumer_app PRIVATE rnqnx_nitro_qt)
    target_compile_definitions(rnqnx_consumer_app PRIVATE RNQNX_PLAYGROUND_NITRO_QT=1)
  endif()
  set_target_properties(rnqnx_consumer_app PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${output_dir}" OUTPUT_NAME "${appId}")
  add_custom_command(TARGET rnqnx_consumer_app POST_BUILD
    COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${bundle}" "-DDESTINATION=${output_dir}/app.bundle.js"
      "-DEXPECTED_SHA256=${bundleSha256}" -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/StageConsumerBundle.cmake" VERBATIM)
  file(MAKE_DIRECTORY "${output_dir}/icons")
  foreach(icon_size icon_path icon_hash IN ZIP_LISTS icon_sizes icon_files icon_hashes)
    add_custom_command(TARGET rnqnx_consumer_app POST_BUILD
      COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${icon_path}" "-DDESTINATION=${output_dir}/icons/icon-${icon_size}.png"
        "-DEXPECTED_SHA256=${icon_hash}" -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/StageConsumerBundle.cmake" VERBATIM)
    install(FILES "${output_dir}/icons/icon-${icon_size}.png" DESTINATION icons COMPONENT ConsumerApp)
  endforeach()
  install(TARGETS rnqnx_consumer_app RUNTIME DESTINATION . COMPONENT ConsumerApp)
  install(FILES "${output_dir}/app.bundle.js" DESTINATION . COMPONENT ConsumerApp)
endfunction()
