include_guard(GLOBAL)
option(RNQNX_ENABLE_METRO_RELOAD "Experimental loopback Metro full reload, not Fast Refresh" OFF)
option(RNQNX_METRO_RELOAD_SANITIZERS "Instrument reload session/tests, not external Qt/RN/Hermes" OFF)
function(rnqnx_configure_metro_reload)
  target_compile_definitions(rnqnx_react_host PUBLIC RNQNX_ENABLE_METRO_RELOAD=$<BOOL:${RNQNX_ENABLE_METRO_RELOAD}>)
  if(NOT RNQNX_ENABLE_METRO_RELOAD)
    return()
  endif()
  if(CMAKE_CROSSCOMPILING OR NOT CMAKE_SYSTEM_NAME MATCHES "^(Linux|Darwin)$" OR NOT CMAKE_BUILD_TYPE STREQUAL "Debug")
    message(FATAL_ERROR "Metro full reload requires a native Linux/Darwin Debug compiler-enabled Hermes host")
  endif()
  if(NOT TARGET hermesvm)
    message(FATAL_ERROR "Metro full reload requires compiler-enabled Hermes")
  endif()
  set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
  target_sources(rnqnx_react_host PRIVATE "${root}/vnext/src/runtime/MetroReloadSession.cpp")
  if(RNQNX_METRO_RELOAD_SANITIZERS)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
      message(FATAL_ERROR "Metro reload sanitizer evidence requires Linux Clang/GNU")
    endif()
    set_source_files_properties("${root}/vnext/src/runtime/MetroReloadSession.cpp" PROPERTIES
      COMPILE_OPTIONS "-fsanitize=address,undefined;-fno-sanitize-recover=undefined;-fno-omit-frame-pointer")
    target_link_options(rnqnx_react_host INTERFACE -fsanitize=address,undefined)
  endif()
  if(BUILD_TESTING)
    add_executable(rnqnx_metro_reload_test "${root}/tests/native/metro-reload/RuntimeTest.cpp")
    target_link_libraries(rnqnx_metro_reload_test PRIVATE rnqnx_react_host)
    rnqnx_enable_strict_warnings(rnqnx_metro_reload_test)
    if(RNQNX_METRO_RELOAD_SANITIZERS)
      target_compile_options(rnqnx_metro_reload_test PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer)
      target_link_options(rnqnx_metro_reload_test PRIVATE -fsanitize=address,undefined)
    endif()
    add_test(NAME rnqnx_metro_reload_test COMMAND rnqnx_metro_reload_test)
    set_tests_properties(rnqnx_metro_reload_test PROPERTIES TIMEOUT 30 ENVIRONMENT "QT_QPA_PLATFORM=offscreen;QT_QUICK_BACKEND=software;ASAN_OPTIONS=detect_leaks=0:halt_on_error=1;UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1")
  endif()
endfunction()
