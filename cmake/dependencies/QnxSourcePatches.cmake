include_guard(GLOBAL)

# Apply only to the hash-pinned sources fetched for a QNX build. Reject source
# drift instead of silently building a partly patched dependency.
function(rnqnx_patch_qnx_source file before after)
  file(READ "${file}" source)
  string(FIND "${source}" "${after}" applied)
  if(NOT applied LESS 0)
    string(REPLACE "${after}" "" remaining "${source}")
    string(LENGTH "${source}" source_length)
    string(LENGTH "${remaining}" remaining_length)
    string(LENGTH "${after}" after_length)
    math(EXPR removed_length "${source_length} - ${remaining_length}")
    string(FIND "${remaining}" "${before}" extra)
    if(NOT removed_length EQUAL after_length OR NOT extra LESS 0)
      message(FATAL_ERROR "QNX patch source contract is ambiguous: ${file}")
    endif()
    return()
  endif()
  string(FIND "${source}" "${before}" first)
  if(first LESS 0)
    message(FATAL_ERROR "QNX patch source contract changed: ${file}")
  endif()
  string(LENGTH "${before}" before_length)
  math(EXPR tail_start "${first} + ${before_length}")
  string(SUBSTRING "${source}" ${tail_start} -1 tail)
  string(FIND "${tail}" "${before}" second)
  if(NOT second LESS 0)
    message(FATAL_ERROR "QNX patch source contract is ambiguous: ${file}")
  endif()
  string(REPLACE "${before}" "${after}" patched "${source}")
  file(WRITE "${file}" "${patched}")
endfunction()
