include_guard(GLOBAL)

function(rnqnx_add_qt_frame_swap_trace)
  if(NOT RNQNX_ENABLE_FRAME_TRACE OR TARGET rnqnx_qt_frame_swap_trace)
    return()
  endif()
  set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
  rnqnx_add_runtime_trace()
  add_library(rnqnx_qt_frame_swap_trace STATIC
    "${root}/vnext/src/runtime/QtFrameSwapTrace.cpp")
  target_link_libraries(rnqnx_qt_frame_swap_trace PUBLIC rnqnx_runtime_trace Qt6::Quick)
  rnqnx_enable_strict_warnings(rnqnx_qt_frame_swap_trace)
  if(BUILD_TESTING)
    add_executable(rnqnx_qt_frame_swap_trace_test "${root}/tests/cpp/QtFrameSwapTraceTest.cpp")
    target_link_libraries(rnqnx_qt_frame_swap_trace_test PRIVATE rnqnx_qt_frame_swap_trace)
    rnqnx_enable_strict_warnings(rnqnx_qt_frame_swap_trace_test)
    set_target_properties(rnqnx_qt_frame_swap_trace_test PROPERTIES
      RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
  endif()
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "QNX" AND RNQNX_ENABLE_HOST_SANITIZERS AND
      CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
    foreach(target rnqnx_qt_frame_swap_trace rnqnx_qt_frame_swap_trace_test)
      if(TARGET ${target})
        target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer)
        target_link_options(${target} PUBLIC -fsanitize=address,undefined)
      endif()
    endforeach()
  endif()
  if(BUILD_TESTING AND NOT CMAKE_CROSSCOMPILING)
    add_test(NAME rnqnx_qt_frame_swap_trace_test COMMAND rnqnx_qt_frame_swap_trace_test -platform offscreen)
    set_tests_properties(rnqnx_qt_frame_swap_trace_test PROPERTIES TIMEOUT 20
      ENVIRONMENT "QT_QUICK_BACKEND=software;QSG_RHI_BACKEND=software")
  endif()
endfunction()
