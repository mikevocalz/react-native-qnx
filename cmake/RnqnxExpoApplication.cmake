include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/RnqnxExpoConstants.cmake")
option(RNQNX_ENABLE_EXPO_APPLICATION "Expose real Qt application metadata through ExpoApplication" OFF)
option(RNQNX_BUILD_EXPO_CONSTANTS_TESTS "Build real Expo Constants native contract tests" OFF)
option(RNQNX_BUILD_EXPO_APPLICATION_TESTS "Build real ExpoApplication native contract tests" OFF)
option(RNQNX_ENABLE_EXPO_MODULES "Install explicitly registered Expo QNX module providers" OFF)
set(RNQNX_EXPO_MODULES_CMAKE "" CACHE FILEPATH "Reviewed generated Expo modules CMake file")
option(RNQNX_BUILD_EXPO_AUTOLINK_TESTS "Build generated provider native host contract" OFF)
function(rnqnx_configure_expo_application)
  target_compile_definitions(rnqnx_react_host PRIVATE RNQNX_ENABLE_EXPO_CONSTANTS=$<BOOL:${RNQNX_ENABLE_EXPO_CONSTANTS}>)
  target_compile_definitions(rnqnx_react_host PRIVATE RNQNX_ENABLE_EXPO_MODULES=$<BOOL:${RNQNX_ENABLE_EXPO_MODULES}>)
  target_compile_definitions(rnqnx_react_host PRIVATE RNQNX_ENABLE_EXPO_APPLICATION=$<BOOL:${RNQNX_ENABLE_EXPO_APPLICATION}>)
  if(RNQNX_ENABLE_EXPO_APPLICATION OR RNQNX_ENABLE_EXPO_MODULES OR RNQNX_ENABLE_EXPO_CONSTANTS)
    if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Linux|QNX)$")
      message(FATAL_ERROR "ExpoApplication supports QNX or Linux native hosts only")
    endif()
    if(NOT TARGET rnqnx_expo_modules_qnx)
      add_subdirectory("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../packages/expo-modules-core-qnx" "${CMAKE_BINARY_DIR}/expo-modules-qnx")
    endif()
    if(RNQNX_ENABLE_EXPO_MODULES)
      if(NOT IS_ABSOLUTE "${RNQNX_EXPO_MODULES_CMAKE}" OR NOT EXISTS "${RNQNX_EXPO_MODULES_CMAKE}")
        message(FATAL_ERROR "Expo modules require an absolute reviewed generated CMake file")
      endif()
      include("${RNQNX_EXPO_MODULES_CMAKE}")
      if(NOT RNQNX_EXPO_AUTOLINK_RUNTIME_READY OR NOT RNQNX_EXPO_AUTOLINK_SOURCE)
        message(FATAL_ERROR "Expo providers with modules must declare registrationFunction; regenerate autolinking")
      endif()
      target_sources(rnqnx_expo_modules_qnx PRIVATE "${RNQNX_EXPO_AUTOLINK_SOURCE}")
      target_link_libraries(rnqnx_expo_modules_qnx PRIVATE ${RNQNX_EXPO_AUTOLINK_TARGETS})
      target_compile_definitions(rnqnx_expo_modules_qnx PRIVATE RNQNX_HAS_EXPO_AUTOLINKING=1)
    endif()
    target_link_libraries(rnqnx_react_host PRIVATE rnqnx_expo_modules_qnx)
  endif()
  if(RNQNX_BUILD_EXPO_AUTOLINK_TESTS)
    if(NOT BUILD_TESTING OR CMAKE_CROSSCOMPILING OR NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
      message(FATAL_ERROR "Expo autolink host tests require native Linux and BUILD_TESTING=ON")
    endif()
    if(RNQNX_ENABLE_EXPO_APPLICATION)
      message(FATAL_ERROR "Autolink isolation test requires ExpoApplication OFF")
    endif()
    add_executable(expo_autolink_host_test "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/native/expo-autolinking/RuntimeTest.cpp")
    target_link_libraries(expo_autolink_host_test PRIVATE rnqnx_react_host)
    target_compile_definitions(expo_autolink_host_test PRIVATE RNQNX_ENABLE_EXPO_MODULES=$<BOOL:${RNQNX_ENABLE_EXPO_MODULES}>)
    add_test(NAME expo_autolink_host COMMAND expo_autolink_host_test)
    set_tests_properties(expo_autolink_host PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen;QT_QUICK_BACKEND=software" TIMEOUT 30)
  endif()
  if(RNQNX_BUILD_EXPO_CONSTANTS_TESTS)
    add_subdirectory("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/native/expo-constants" "${CMAKE_BINARY_DIR}/expo-constants-tests")
  endif()
  if(RNQNX_BUILD_EXPO_APPLICATION_TESTS)
    add_subdirectory("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/native/expo-application" "${CMAKE_BINARY_DIR}/expo-application-tests")
  endif()
endfunction()
