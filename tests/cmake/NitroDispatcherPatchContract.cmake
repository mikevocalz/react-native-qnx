set(original "${REPO_ROOT}/node_modules/nitro-core/native/cpp/include/NitroModules")
set(copy "${WORK_DIR}/native/cpp/include/NitroModules")
file(MAKE_DIRECTORY "${copy}")
foreach(name Dispatcher.hpp Callback.hpp)
  file(COPY_FILE "${original}/${name}" "${copy}/${name}")
  file(SHA256 "${original}/${name}" "original_${name}")
endforeach()
set(patch "${REPO_ROOT}/cmake/dependencies/NitroDispatcherPatches.cmake")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DRNQNX_NITRO_CORE_ROOT=${WORK_DIR}" -P "${patch}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Fresh Nitro dispatcher patch failed: ${output}${error}")
endif()
foreach(name Dispatcher.hpp Callback.hpp)
  file(SHA256 "${copy}/${name}" "first_${name}")
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DRNQNX_NITRO_CORE_ROOT=${WORK_DIR}" -P "${patch}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Repeated Nitro dispatcher patch failed: ${output}${error}")
endif()
foreach(name Dispatcher.hpp Callback.hpp)
  file(SHA256 "${copy}/${name}" repeated)
  file(SHA256 "${original}/${name}" unchanged)
  if(NOT repeated STREQUAL "${first_${name}}" OR NOT unchanged STREQUAL "${original_${name}}")
    message(FATAL_ERROR "Patch is not idempotent or modified installed Nitro: ${name}")
  endif()
endforeach()
# Simulated upstream drift must fail closed, rather than produce a partial port.
file(READ "${original}/Dispatcher.hpp" source)
string(REPLACE "runAsync([function =" "runAsync([changedCapture =" source "${source}")
file(WRITE "${copy}/Dispatcher.hpp" "${source}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DRNQNX_NITRO_CORE_ROOT=${WORK_DIR}" -P "${patch}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "source contract changed")
  message(FATAL_ERROR "Changed Nitro source was not rejected: ${output}${error}")
endif()
