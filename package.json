{
  "name": "react-native-qnx-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Production-grade React Native out-of-tree platform for QNX",
  "license": "MIT",
  "author": "react-native-qnx contributors",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.18.0"
  },
  "scripts": {
    "doctor": "bash scripts/doctor.sh",
    "configure:qnx": "bash scripts/configure-qnx.sh",
    "build:qnx": "bash scripts/build-qnx.sh",
    "bootstrap:macos": "bash scripts/bootstrap-macos.sh",
    "validate:macos": "bash scripts/validate-macos.sh",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:js && pnpm test:cpp:host",
    "test:js": "node scripts/run-js-tests.mjs",
    "test:cpp:host": "node scripts/run-cpp-host-tests.mjs",
    "codegen:check": "node scripts/codegen-check.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "validate:dependencies": "node scripts/validate-dependencies.mjs",
    "validate:manifests": "node scripts/validate-manifests.mjs",
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "pi:preflight": "bash scripts/pi-preflight.sh",
    "pi:install": "bash scripts/install-pi.sh",
    "qnx:validate:805": "bash scripts/validate-qnx-805-cross.sh",
    "hermes:qnx:prepare": "bash scripts/prepare-hermes-qnx.sh",
    "hermes:qnx:configure": "bash scripts/configure-hermes-qnx.sh",
    "validate:qnx-nitro": "node scripts/validate-qnx-nitro.mjs",
    "pi:evidence:verify": "node scripts/verify-pi-evidence.mjs",
    "validate:qnx-expo-modules": "node scripts/validate-qnx-expo-modules.mjs",
    "validate:qnx-expo-autolinking": "node scripts/validate-qnx-expo-autolinking.mjs",
    "validate:expo-sdk58-support": "node scripts/expo-sdk58-support.mjs --check",
    "expo:sdk58-support:write": "node scripts/expo-sdk58-support.mjs --write",
    "qnx:runtime:validate": "bash scripts/validate-runtime-qnx.sh",
    "validate:qnx-react": "node scripts/validate-react-qnx-source.mjs",
    "nitro:platform:generate": "node scripts/nitro-platform-codegen.mjs --write",
    "nitro:platform:check": "node scripts/nitro-platform-codegen.mjs --check",
    "qnx": "node packages/react-native-qnx-cli/src/bin.mjs",
    "qnx:device": "node packages/qnx-devtools/src/cli.mjs",
    "expo:qnx": "node packages/expo-qnx/src/cli.mjs",
    "validate:clean-app": "bash scripts/validate-clean-app.sh",
    "docs:sync": "node scripts/validate-docs.mjs --write",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:v1": "node scripts/validate-docs.mjs --release"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.88.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.25",
    "expo": "58.0.24",
    "metro": "0.87.1",
    "nitrogen": "1.0.0-alpha.nightly.136.gdb81de61bd32",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-modules": "1.0.0-alpha.nightly.136.gdb81de61bd32",
    "typescript": "7.0.2",
    "nitro-core": "1.0.0-alpha.nightly.136.gdb81de61bd32",
    "@typescript/typescript6": "6.0.2",
    "zustand": "5.1.0"
  }
}
