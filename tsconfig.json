{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "tests/js/**/*.ts",
    "tests/js/**/*.mjs",
    "packages/react-native-qnx-cli/src/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "build",
    "tests/js/qnx-gallery-yoga-layout.test.mjs",
    "tests/js/helpers/yoga-host.mjs"
  ]
}
