+// The software scene graph renders into paintDevice() and then asks for the
+// result through toImage() when QQuickWindow::grabWindow() is called. Without
+// this override the base class returns a null image and every grab fails.
+QImage QQnxRasterBackingStore::toImage() const
+{
+    QQnxRasterWindow *window = platformWindow();
+    if (window && window->hasBuffers()) {
+        if (const QImage *image = window->renderBuffer().image())
+            return image->copy();
+    }
+
+    return QImage();
+}
