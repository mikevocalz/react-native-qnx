+
+QPlatformOffscreenSurface *QQnxIntegration::createPlatformOffscreenSurface(QOffscreenSurface *surface) const
+{
+    // Without this, QOffscreenSurface falls back to a hidden QWindow. On QNX that
+    // hidden QWindow still creates a top-level screen application window, which
+    // a window manager such as fullscreen-winmgr manages like any other app
+    // window. Qt Quick creates one for every OpenGL-rendered QQuickWindow, and
+    // under fullscreen-winmgr the real window then stays black. A pbuffer, or a
+    // surfaceless context when EGL_KHR_surfaceless_context is available, needs
+    // no screen window.
+    QEGLPlatformContext::Flags flags;
+    if (!(options() & SurfacelessEGLContext))
+        flags |= QEGLPlatformContext::NoSurfaceless;
+    auto *pbuffer = new QEGLPbuffer(m_eglDisplay, surface->requestedFormat(), surface, flags);
+    qCDebug(lcQpaQnx) << Q_FUNC_INFO << "valid =" << pbuffer->isValid();
+    return pbuffer;
+}
 #endif
 
